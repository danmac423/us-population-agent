# Copy to .env and fill in. Variables without a default are required.
# Commented-out variables are optional; the value shown is the default.

# --- Anthropic ---
ANTHROPIC_API_KEY=your-anthropic-api-key
# Light model: classification, rewriting, table selection and replies.
ANTHROPIC_MODEL_NAME=claude-haiku-5-5
# Strong model: writes and repairs the SQL.
# ANTHROPIC_STRONG_MODEL_NAME=claude-sonnet-5-5

# --- Postgres (conversation checkpoints) ---
# Local run (matches the postgres service in docker-compose.yml). Inside compose the api service
# overrides this to use the `postgres` host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent

# --- Snowflake connection ---
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-user
SNOWFLAKE_PASSWORD=your-password
# Use a read-only role: the generated SQL runs with it.
SNOWFLAKE_ROLE=your-read-only-role
SNOWFLAKE_WAREHOUSE=your-warehouse

# --- Snowflake app database (Cortex Search service, columns table, geography table) ---
SNOWFLAKE_DATABASE=your-app-database
SNOWFLAKE_SCHEMA=your-app-schema
SNOWFLAKE_SEARCH_SERVICE=your-cortex-search-service
SNOWFLAKE_COLUMNS_TABLE=your-columns-table
SNOWFLAKE_GEOGRAPHY_TABLE=your-geography-table

# --- Census data shared from the Snowflake Marketplace (read-only) ---
SNOWFLAKE_CENSUS_DATABASE=your-census-database
SNOWFLAKE_CENSUS_SCHEMA=your-census-schema

# --- Web API ---
# When set, /chat requires it in the X-API-Key header. Leave it unset (not empty) for open access.
# API_KEY=your-api-key
# TURN_TIMEOUT_SECONDS=120
# MAX_MESSAGE_CHARS=1000

# --- Logging ---
# LOG_LEVEL=WARNING

# --- Agent limits ---
# MAX_REPAIRS=2
# MAX_SEARCH_QUERIES=4
# MAX_CANDIDATES=8
# SEARCH_LIMIT=5
# MAX_CONTEXT_TOKENS=2000

# --- Timeouts and retries ---
# LLM_MAX_RETRIES=4
# LLM_TIMEOUT_SECONDS=30
# QUERY_TIMEOUT_SECONDS=30
# LOGIN_TIMEOUT_SECONDS=20

# --- Local run and docker compose ---
# Address of the API used by the Streamlit frontend when run outside compose.
# API_URL=http://localhost:8000
# API_PORT=8000
# FRONTEND_PORT=8501
# POSTGRES_PORT=5432
